{
  "name": "carbon-stories-persona-loader",
  "version": "1.0.0",
  "description": "Portable editor for Carbon Stories StreamingAssets personas",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.carbonstories.personaloader",
    "productName": "Persona Loader",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "persona-editor.html",
      "package.json"
    ],
    "directories": {
      "output": "../../StreamingAssets/dist"
    },
    "win": {
      "target": "dir",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    }
  }
}
